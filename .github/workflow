name: Build Cheat Engine

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: windows-latest

    steps:
    - name: Checkout repository
      uses: actions/checkout@v4

    - name: Install Lazarus
      uses: gwennael-dufour/setup-lazarus@v1
      with:
        lazarus-version: '2.2.6'

    - name: Build Cheat Engine
      run: |
        cd "Cheat Engine"
        lazbuild --build-mode="Release 64-Bit" cheatengine.lpi

    - name: Upload Executable
      uses: actions/upload-artifact@v4
      with:
        name: CheatEngine-EXE
        path: |
          Cheat Engine/bin/*.exe
